<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary navigation: the page on top slides sideways and the one underneath is revealed.
     No alpha anywhere, the roots are opaque on purpose so the reveal reads as depth and not as a
     crossfade. Animators, not anim resources: only an Animator can be seeked by predictive back -->
<set xmlns:android="http://schemas.android.com/apk/res/android">

    <objectAnimator
        android:duration="300"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="translationX"
        android:valueFrom="0dp"
        android:valueTo="@dimen/nav_slide_parallax"
        android:valueType="floatType" />

    <objectAnimator
        android:duration="300"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="scaleX"
        android:valueFrom="1"
        android:valueTo="0.94"
        android:valueType="floatType" />

    <objectAnimator
        android:duration="300"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="scaleY"
        android:valueFrom="1"
        android:valueTo="0.94"
        android:valueType="floatType" />

</set>