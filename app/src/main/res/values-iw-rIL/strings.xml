    <string name="add_demo_entries_title">הוספת אירועים לדוגמה</string>
    <string name="add_demo_entries_description">מילוי מסד הנתונים באירועים לדוגמה, בעיקר של שחקנים ודמויות היסטוריות</string>
    <string name="add_demo_entries_dialog_description">זה יוסיף לצמיתות אלפי רשומות למסד הנתונים, ונועד למטרות ניפוי שגיאות debug. זה לא ימחק אירועים קיימים, אך אם תרצה למחוק את הרשומות החדשות, יהיה עליך לעשות זאת ידנית. בהצלחה עם זה.</string>
