<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadingEdgeLength="@dimen/linear_vertical_margin"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical"
    android:transitionGroup="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/activity_horizontal_margin"
        tools:context=".activities.CompactWidgetConfigurationActivity">

        <!-- Title with animated settings icon -->
        <ImageView
            android:id="@+id/configurationTitleImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/event_details"
            app:layout_constraintBottom_toBottomOf="@id/configurationTitle"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toStartOf="@id/configurationTitle"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/configurationTitle"
            app:srcCompat="@drawable/animated_nav_settings"
            app:tint="?attr/colorPrimary" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/configurationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:drawablePadding="@dimen/activity_vertical_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="@dimen/in_row_padding"
            android:text="@string/widget_configuration_title"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/configurationTitleImage"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/configurationTitle">

            <!-- Hide images switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hide_images"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/configurationShowPhotosSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    android:paddingEnd="@dimen/card_margin" />
            </LinearLayout>

            <!-- Scrolling list of the events instead of those that fit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/compact_widget_scroll"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/configurationScrollSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    android:paddingEnd="@dimen/card_margin" />
            </LinearLayout>

            <!-- Birth date position -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/birth_date"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <Spinner
                    android:id="@+id/configurationDatePositionSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    tools:ignore="RtlSymmetry" />
            </LinearLayout>

            <!-- Zodiac sign position -->
            <LinearLayout
                android:id="@+id/configurationZodiacRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zodiac_sign"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <Spinner
                    android:id="@+id/configurationZodiacPositionSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    tools:ignore="RtlSymmetry" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_margin" />

            <!-- Background opacity, with Monet too -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/compact_widget_opacity"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textSize="@dimen/custom_preference_title_text_size" />

            <com.google.android.material.slider.Slider
                android:id="@+id/configurationOpacitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="0"
                android:valueTo="100" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/configurationOpacityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                tools:text="100%" />

            <!-- Monet switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/monet"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/configurationMonetSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    android:paddingEnd="@dimen/card_margin" />
            </LinearLayout>

            <!-- Text size — always visible regardless of Monet -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/compact_widget_text_size"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textSize="@dimen/custom_preference_title_text_size" />

            <com.google.android.material.slider.Slider
                android:id="@+id/configurationTextSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="19" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/configurationTextSizeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                tools:text="12 sp" />

            <!-- Color settings — hidden when Monet is ON -->
            <LinearLayout
                android:id="@+id/colorSettingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Background color -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/compact_widget_bg_color"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_padding"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bgColorPickerContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/widget_margin" />
                </HorizontalScrollView>

                <!-- General text color -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/compact_widget_text_color"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_padding"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/generalTextColorPickerContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/widget_margin" />
                </HorizontalScrollView>

                <!-- Today highlight section -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/linear_vertical_margin"
                    android:text="@string/today"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_margin" />

                <!-- Highlight text color -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/compact_widget_text_color"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_padding"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/textColorPickerContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/widget_margin" />
                </HorizontalScrollView>

                <!-- Highlight background color -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/compact_widget_bg_color"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_padding"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/colorPickerContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/widget_margin" />
                </HorizontalScrollView>

                <!-- Highlight opacity -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/compact_widget_opacity"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textSize="@dimen/custom_preference_title_text_size" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/configurationHighlightOpacitySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="10"
                    android:valueTo="100" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/configurationHighlightOpacityValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    tools:text="60%" />

            </LinearLayout>

        </LinearLayout>

        <!-- Confirm FAB at the bottom center -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/configurationConfirmButton"
            style="@style/Widget.Material3.FloatingActionButton.Large.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:contentDescription="@android:string/ok"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_appintro_done" />

        <!-- Preview of the compact widget layout, just above the confirm FAB.
             The background color is overridden at runtime to follow the user's choices. -->
        <LinearLayout
            android:id="@+id/previewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/linear_vertical_margin"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="@dimen/widget_margin"
            android:theme="@style/WidgetTheme"
            app:layout_constraintBottom_toTopOf="@id/configurationConfirmButton"
            app:layout_constraintTop_toBottomOf="@id/settingsContainer">

            <!-- Today's birthday row (highlighted) -->
            <LinearLayout
                android:id="@+id/previewHighlightRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/in_row_padding">

                <ImageView
                    android:id="@+id/previewAvatar1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/next_event"
                    android:src="@drawable/preview_avatar_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/in_row_padding">

                    <LinearLayout
                        android:id="@+id/previewDateAbove1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/previewZodiacBeforeAbove1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_aries"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="date"
                            android:text="1990-03-26"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#B3FFFFFF"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/previewZodiacAfterAbove1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_aries"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alice Smith"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="#FFFFFFFF"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:id="@+id/previewDateBelow1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/previewZodiacBeforeBelow1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_aries"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="date"
                            android:text="1990-03-26"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#B3FFFFFF"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/previewZodiacAfterBelow1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_aries"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/in_row_padding"
                    android:tag="date"
                    android:text="36"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#B3FFFFFF"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/in_row_padding"
                    android:text="@string/today"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <!-- Normal row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/in_row_padding">

                <ImageView
                    android:id="@+id/previewAvatar2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/next_event"
                    android:src="@drawable/preview_avatar_2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/in_row_padding">

                    <LinearLayout
                        android:id="@+id/previewDateAbove2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/previewZodiacBeforeAbove2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_leo"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="date"
                            android:text="1985-04-02"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#B3FFFFFF"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/previewZodiacAfterAbove2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_leo"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bob Jones"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="#FFFFFFFF"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:id="@+id/previewDateBelow2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/previewZodiacBeforeBelow2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_leo"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="date"
                            android:text="1985-04-02"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#B3FFFFFF"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/previewZodiacAfterBelow2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_leo"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/in_row_padding"
                    android:tag="date"
                    android:text="41"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#B3FFFFFF"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/previewCountdown2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/in_row_padding"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="#FFFFFFFF"
                    tools:text="7 days left" />
            </LinearLayout>

            <!-- Normal row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/in_row_padding">

                <ImageView
                    android:id="@+id/previewAvatar3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/next_event"
                    android:src="@drawable/preview_avatar_initial" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/in_row_padding">

                    <LinearLayout
                        android:id="@+id/previewDateAbove3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/previewZodiacBeforeAbove3"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_sagittarius"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="date"
                            android:text="1992-04-10"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="#B3FFFFFF"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/previewZodiacAfterAbove3"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/zodiac_sign"
                            android:src="@drawable/ic_zodiac_sagittarius"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carol Lee"
