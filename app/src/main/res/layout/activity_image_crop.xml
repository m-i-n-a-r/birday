<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/imageCropRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ImageCropActivity">

    <com.canhub.cropper.CropImageView
        android:id="@+id/cropImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cropAspectRatioX="1"
        app:cropAspectRatioY="1"
        app:cropAutoZoomEnabled="true"
        app:cropFixAspectRatio="true"
        app:cropGuidelines="onTouch"
        app:cropScaleType="centerInside"
        app:cropShowProgressBar="true" />

    <!-- Neutral surface FAB for the secondary dismiss action -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/imageCropCancelButton"
        style="@style/Widget.Material3.FloatingActionButton.Surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:contentDescription="@string/cancel"
        app:srcCompat="@drawable/ic_close_24dp" />

    <!-- Primary FAB for the main confirm action -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/imageCropConfirmButton"
        style="@style/Widget.Material3.FloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:contentDescription="@android:string/ok"
        app:srcCompat="@drawable/ic_check_24dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
