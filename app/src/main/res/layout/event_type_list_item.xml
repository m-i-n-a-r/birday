<?xml version="1.0" encoding="utf-8"?>
<!-- One row of an exposed dropdown menu, shared by the event type picker and by the contact
     suggestions. Material 3 wants a menu item 48dp tall with the text inset by the usual margin,
     and giving the row an unambiguous height is also what stops the popup from measuring itself
     short and clipping its last entry -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:drawablePadding="@dimen/text_field_horizontal_margin"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:minHeight="@dimen/dropdown_item_min_height"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:paddingVertical="@dimen/list_vertical_padding"
    android:textAppearance="?attr/textAppearanceBodyLarge"
    android:textColor="?attr/colorOnSurface"
    app:drawableStartCompat="@drawable/ic_dot_small_24dp" />
