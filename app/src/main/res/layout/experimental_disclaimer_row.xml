<?xml version="1.0" encoding="utf-8"?>
<!-- The disclaimer of the experimental settings, in a tonal card of its own color -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/form_vertical_margin">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.CardView.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/disclaimer_card_background"
        app:cardElevation="0dp">

        <LinearLayout
            android:id="@+id/experimentalDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/activity_vertical_margin">

            <ImageView
                android:id="@+id/animated_danger"
                android:layout_width="match_parent"
                android:layout_height="@dimen/minar_banner_height"
                android:contentDescription="@string/experimental_settings_title"
                android:src="@drawable/animated_experimental_danger" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center"
                android:text="@string/experimental_disclaimer"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/appVersionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/linear_vertical_margin"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <Button
                android:id="@+id/checkGithubButton"
                style="@style/Widget.Material3Expressive.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/in_row_button_padding"
                android:contentDescription="@string/check_github"
                android:paddingVertical="@dimen/in_row_button_padding"
                android:text="@string/check_github"
                android:textColor="?attr/colorPrimary"
                android:tint="?attr/colorPrimary"
                app:icon="@drawable/ic_github_black_24dp"
                app:rippleColor="?attr/colorPrimary" />

            <Button
                android:id="@+id/translateButton"
                style="@style/Widget.Material3Expressive.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/in_row_button_padding"
                android:contentDescription="@string/translate_app"
                android:paddingVertical="@dimen/in_row_button_padding"
                android:text="@string/translate_app"
                android:textColor="?attr/colorPrimary"
                android:tint="?attr/colorPrimary"
                app:icon="@drawable/ic_translate_24dp"
                app:rippleColor="?attr/colorPrimary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
