<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="ring"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="ring_path"
                    android:fillColor="#000000"
                    android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8 8,3.59 8,8 -3.59,8 -8,8z" />
            </group>
            <group
                android:name="stem"
                android:pivotX="12"
                android:pivotY="17">
                <path
                    android:name="stem_path"
                    android:fillColor="#000000"
                    android:pathData="M11,11h2v6h-2z" />
            </group>
            <group
                android:name="dot"
                android:pivotX="12"
                android:pivotY="8">
                <path
                    android:name="dot_path"
                    android:fillColor="#000000"
                    android:pathData="M11,7h2v2h-2z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- The ring breathes once, then the i writes itself back in: stem from its base, dot last -->
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1.0"
                    android:valueTo="1.12"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:valueFrom="1.0"
                    android:valueTo="1.12"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="stem">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="360"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="180"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="520"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="520"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
