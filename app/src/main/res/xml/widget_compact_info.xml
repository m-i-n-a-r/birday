<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/appwidget_compact"
    android:initialKeyguardLayout="@layout/widget_compact"
    android:initialLayout="@layout/widget_compact"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/birday_compact_widget_preview"
    android:previewLayout="@layout/widget_compact_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="10800000"
    android:configure="com.minar.birday.activities.CompactWidgetConfigurationActivity"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    tools:targetApi="s" /><!-- Updated every 3 hours, default size is 4 * 2, it can be resized down to a height of 1. The target cells need Android 12, minWidth and minHeight are for the launchers before it -->
