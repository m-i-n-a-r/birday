    <!-- Introduction slides -->
    <string name="slide_one_title">Birday Chào bạn!</string>
    <string name="slide_one_description">Birday là một ứng dụng đơn giản và nhẹ để quản lý các sự kiện quan trọng! 
    Bạn có thể sử dụng Birday để ghi nhớ và lưu trữ ngày sinh nhật của những người bạn yêu thương, trong một cách đáng tin cậy và nhanh chóng.
    </string>
    <string name="slide_two_title">Miễn phí, đơn giản, tùy biến</string>
    <string name="slide_two_description">Birday là miễn phí, không có quảng cáo và nguồn mở. Birday cung cấp một bộ số liệu thống kê về ngày sinh nhật của bạn, một hệ thống yêu thích và giao diện tùy biến. Và đảm bảo hỗ trợ và cập nhật!
    </string>
    <string name="slide_three_title">Nhập từ Danh bạ</string>
    <string name="slide_three_description">Bạn cũng có thể nhập ngày sự kiện mà bạn đã lưu từ Danh bạ của bạn. Birday có thể làm điều đó cho bạn, chỉ cần cấp quyền liên hệ. Thưởng thức!
    </string>
