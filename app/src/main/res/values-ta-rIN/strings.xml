    <!-- Notifications -->
    <string name="events_notification_channel">நிகழ்வு நினைவூட்டல்</string>
    <string name="events_channel_description">வரவிருக்கும் நிகழ்வுகள் குறித்த Birday நினைவூட்டல்கள்</string>
    <string name="notification_title">Birday நினைவூட்டல்</string>
    <string name="notification_description_part_1">இன்றைய நிகழ்வுகள்</string>
    <string name="notification_description_part_2">இனிய நாளாக அமையட்டும்!</string>
    <string name="additional_notification_text">விரைவில் வரும் நிகழ்வுகள்!</string>
    <!-- Introduction slides -->
    <string name="slide_one_title">Birday உங்களை வரவேற்கிறது!</string>
    <string name="slide_one_description">முக்கியமான நிகழ்வுகளை நிர்வகிக்க உதவும் எளிய, இலகுவான செயலி Birday!\nஉங்களுக்குப் பிரியமானவர்களின் பிறந்தநாட்களையும் பிற நிகழ்வுகளையும் விரைவாகவும் நம்பகமாகவும் சேமித்து நினைவில் வைத்திருக்க இதைப் பயன்படுத்தலாம்.</string>
    <string name="slide_two_title">இலவசம், எளிமை, விருப்பப்படி மாற்றலாம்</string>
    <string name="slide_two_description">Birday இலவசமான, விளம்பரமற்ற, திறந்த மூலச் செயலி.\nநிகழ்வுகளின் புள்ளிவிவரங்கள், பிடித்த நிகழ்வுகளைத் தேர்ந்தெடுக்கும் வசதி, விருப்பப்படி மாற்றக்கூடிய இடைமுகம் ஆகியவற்றை வழங்குகிறது. ஆதரவும் புதுப்பிப்புகளும் தொடர்ந்து கிடைக்கும்!</string>
    <string name="slide_three_title">தொடர்புகளிலிருந்து இறக்குமதி செய்</string>
    <string name="slide_three_description">உங்கள் தொடர்புகளில் ஏற்கெனவே சேமித்த நிகழ்வுகளையும் இறக்குமதி செய்யலாம். தொடர்புகளுக்கான அனுமதியை வழங்கினால் போதும்; Birday அவற்றை இறக்குமதி செய்யும். மகிழ்ச்சியாகப் பயன்படுத்துங்கள்!</string>
