    <string name="import_contacts_description">புள்ளிவிவரங்கள் துல்லியமாக இருக்க, ஆண்டு குறிப்பிடப்படாத நிகழ்வுகளில் ஆண்டைச் சேர்க்க மறக்காதீர்கள்!</string>
