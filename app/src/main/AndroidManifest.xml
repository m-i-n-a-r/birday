<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>

        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.viber.voip" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="ch.threema.app" />
    </queries>

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Exact alarms for midnight widget refresh (API 33+ auto-granted for reminder apps) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ExactAlarmPolicy" />
    <!-- Fallback for API 31-32 (requires user to grant in Settings → Special app access) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Needed to reschedule the midnight widget alarm, which doesn't survive a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:backupInForeground="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SplashTheme"
        tools:ignore="UnusedAttribute">

        <!-- Main, Material 3 and complete widget -->
        <receiver
            android:name=".widgets.EventWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>

        <!-- Compact table widget -->
        <receiver
            android:name=".widgets.CompactWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- Old minimal text only widget -->
        <receiver
            android:name=".widgets.MinimalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_info" />
        </receiver>

        <!-- Notification action -->
        <receiver
            android:name=".receivers.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Fires at 00:00:30 every day to refresh widgets; also handles BOOT_COMPLETED -->
        <receiver
            android:name=".receivers.WidgetMidnightReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.minar.birday.action.WIDGET_MIDNIGHT_UPDATE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Birday's events in the Axiris launcher search. Exported because Axiris is another app;
             the provider itself answers only Axiris. Contract: github.com/m-i-n-a-r/yawncher,
             docs/INTEGRATIONS.md -->
        <provider
            android:name=".integrations.AxirisSearchProvider"
            android:authorities="${applicationId}.axiris"
            android:exported="true">
            <intent-filter>
                <action android:name="com.minar.axiris.action.INTEGRATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </provider>

        <!-- Main activity, the core of Birday -->
        <activity
            android:name=".activities.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First launch introduction activity -->
        <activity
            android:name=".activities.WelcomeActivity"
            android:label="@string/app_welcome"
            android:noHistory="true"
            android:theme="@style/AppTheme" />

        <!-- Activity to configure the compact widget -->
        <activity
            android:name=".activities.CompactWidgetConfigurationActivity"
            android:exported="true"
            android:label="@string/widget_configuration_title"
            android:noHistory="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Activity to configure the minimal widget -->
        <activity
            android:name=".activities.MinimalWidgetConfigurationActivity"
            android:exported="true"
            android:label="@string/widget_configuration_title"
            android:noHistory="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".widgets.EventWidgetService"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".widgets.CompactWidgetService"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Hosts the image cropper view for event pictures -->
        <activity
            android:name=".activities.ImageCropActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

    </application>

</manifest>